# Runtime secrets for the contact form. Copy to .env.local for local dev, or
# pull the real values with `vercel env pull --yes`.
#
# .env* is gitignored — never commit real values.

# Airtable Personal Access Token for the SITE.
# Scope it to the Velquor base only, with data.records:write.
# Do NOT grant schema access, and do NOT prefix with NEXT_PUBLIC_ — that would
# publish a write handle on the base to every visitor.
AIRTABLE_TOKEN=

# Base and table the contact form writes to.
# The live base is "Velquor" → appQ9pQrA0dkBKfOj, table "Leads".
AIRTABLE_BASE_ID=
AIRTABLE_TABLE=Leads

# Calendly event type the /book page embeds.
# Public by definition — it is already a public scheduling page, so this is the
# one Calendly value allowed to carry NEXT_PUBLIC_. The webhook signing key and
# API token, when they land, follow the AIRTABLE_TOKEN rule instead.
# Optional: app/lib/calendly.ts falls back to the live URL if it is unset.
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/velquortechnologies/30min

# ---------------------------------------------------------------------------
# NOT used at runtime — schema provisioning only.
# scripts/setup-airtable.js reads AIRTABLE_SETUP_TOKEN (needs schema.bases:write)
# and AIRTABLE_WORKSPACE_ID. Pass them inline for that one-off run; keep them
# out of this file and out of Vercel.
# ---------------------------------------------------------------------------
