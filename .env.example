AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE=Leads
NEXT_PUBLIC_CALENDLY_URL=

# Cloudflare Turnstile. Create a widget at
# https://dash.cloudflare.com/?to=/:account/turnstile — mode "Managed",
# hostnames velquortech.com and localhost.
#
# The site key is public: it ships in the client bundle by design, which is why
# it carries the NEXT_PUBLIC_ prefix. The secret key must NEVER get that prefix.
# Without the secret set, leads are still written but filed as "Unverified".
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Emergency lever, off unless set to exactly "1". Normally a submission with no
# Turnstile token is written and quarantined as "Unverified", so the form keeps
# working with JavaScript disabled. Set this during an active flood to drop that
# lane instead of writing it, and unset it afterwards.
# TURNSTILE_REQUIRE=1
